<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Manual rescan. Always available, and always reports its outcome — a
         refresh that says nothing cannot be told apart from a broken one. -->
    <string name="shelf_refresh">Check for new screenshots</string>
    <plurals name="shelf_refresh_found">
        <item quantity="one">Found %d new screenshot</item>
        <item quantity="other">Found %d new screenshots</item>
    </plurals>
    <plurals name="shelf_refresh_removed">
        <item quantity="one">Removed %d deleted screenshot</item>
        <item quantity="other">Removed %d deleted screenshots</item>
    </plurals>
    <string name="shelf_refresh_none">Nothing changed — no new or deleted screenshots</string>

    <!--
      Upsell shown after a scan finds more screenshots than the free window keeps.

      Deliberately does NOT say "free trial". The free tier never expires, so calling
      it a trial would be inaccurate, would contradict the store listing's "no trial,
      no expiry", and is the kind of misdescribed offer Play takes a dim view of. It
      says "free version" throughout.

      It also states what the free tier still DOES rather than only what it withholds,
      because a dialog that reads purely as a restriction gets dismissed unread.
    -->
    <!--
      Rewritten for clarity. The previous version had three problems:

      "One payment unlocks all 105" put an unusual noun phrase in the subject
      position, which reads as translated English. The standard phrasing for this is
      a one-time purchase, and the reassurance belongs in its own short sentence.

      It also crammed three separate offers into one sentence, and never said the
      price — a purchase prompt that does not state what it costs makes people
      hesitate no matter how good the offer is.
    -->
    <string name="upsell_title">%1$d screenshots found</string>

    <!-- %1$d = free limit, %2$d = total found. -->
    <string name="upsell_body">Right now you can search your %1$d most recent screenshots. The other %2$d are on your shelf, but their text is not searchable yet.\n\nThe full version makes all of them searchable, including every screenshot you take from now on. You can also add other folders, such as WhatsApp and Telegram.</string>

    <!-- Shown when Play has given us a price. -->
    <string name="upsell_price">%1$s, paid once. No subscription and no renewals.</string>
    <!-- Fallback when the price is not yet known, so the dialog is never misleading. -->
    <string name="upsell_price_unknown">A single purchase. No subscription and no renewals.</string>

    <string name="upsell_continue_free">Not now</string>
    <string name="upsell_unlock">Get the full version</string>
    <!-- With the price on the button, the decision needs no extra reading. -->
    <string name="upsell_unlock_priced">Unlock for %1$s</string>
    <string name="shelf_refresh_no_access">Shelfie cannot read your screenshots. Check permissions in Settings.</string>

    <string name="shelf_limited_empty_title">Pick a few screenshots</string>
    <string name="shelf_limited_empty_body">Shelfie will read them and make them searchable. Everything works the same in Limited Mode.</string>
    <string name="shelf_limited_empty_cta">Choose screenshots</string>

    <string name="shelf_empty_title">Nothing on the shelf yet</string>
    <string name="shelf_empty_body">Take a screenshot and it\'ll land here automatically.</string>

    <string name="shelf_date_today">Today</string>
    <string name="shelf_date_yesterday">Yesterday</string>

</resources>
