    <!-- Indexing status. Informational, never blocking.

         The detail line deliberately does NOT promise "the rest finish while
         charging". That claim was shown unconditionally, including to free users
         whose remaining screenshots were held back by the tier limit and would
         never be read no matter how long the phone charged. -->
    <string name="index_status_title">Reading your screenshots</string>
    <plurals name="index_status_detail">
        <item quantity="one">%1$d of %2$d read · the rest continue in the background</item>
        <item quantity="other">%1$d of %2$d read · the rest continue in the background</item>
    </plurals>
    <string name="index_status_hide">Hide indexing status</string>

    <!-- Limited Mode. A working state, not an error. -->
    <string name="limited_mode_title">Limited Mode</string>
    <string name="limited_mode_empty">Shelfie can only see screenshots you choose. Add some to get started.</string>
    <plurals name="limited_mode_selected">
        <item quantity="one">Shelfie can see %d screenshot you selected.</item>
        <item quantity="other">Shelfie can see %d screenshots you selected.</item>
    </plurals>
    <plurals name="limited_mode_picked">
        <item quantity="one">Shelfie can see %d screenshot you picked.</item>
        <item quantity="other">Shelfie can see %d screenshots you picked.</item>
    </plurals>
    <string name="limited_mode_add_more">Add more</string>
    <string name="limited_mode_allow_all">Allow all</string>

