<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Broad photo access. Justified under Google Play's Photo and Video
      Permissions policy as a gallery-class app whose core function is managing
      and searching the user's entire screenshot library. A Play Console
      declaration is required — see docs/06-play-store-compliance.md.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Android 14+ partial access. Handled as a first-class state, not an error. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Legacy read path for API 26..32, which predate the granular media permissions. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Optional. At most one storage-cleanup suggestion per week. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      DELIBERATELY ABSENT: android.permission.INTERNET
      and android.permission.ACCESS_NETWORK_STATE.

      This is an architectural commitment, not an oversight. Without INTERNET the
      OS makes it impossible for this app to upload anything, which turns our
      privacy claim into something the user can verify in system settings.
      Adding either permission would break that promise and would also
      invalidate the Play Data Safety declaration.

      Consequence: no analytics, no crash reporting SDK, no ads, no remote
      config. Rely on Play Console vitals instead.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:name=".ShelfieApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shelfie.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Shelfie.Starting"
            android:windowSoftInputMode="adjustResize">
            <!--
              No screenOrientation lock. Android 17 (API 37) removes the
              opt-out from resizability and orientation constraints on large
              screens, so the app must adapt rather than pin itself.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Remove WorkManager's automatic startup initializer.

          ShelfieApplication implements Configuration.Provider, so WorkManager
          initialises on demand at the first getInstance() call instead of during
          app startup. That keeps work off the cold-start path, which matters for
          the sub-500ms budget on budget devices.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
